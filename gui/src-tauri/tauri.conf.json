{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STAR FORGE Launcher",
  "mainBinaryName": "star-forge",
  "version": "0.1.1",
  "identifier": "star-forge",
  "build": {
    "removeUnusedCommands": true,
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "focus": false,
        "decorations": false,
        "title": "STAR FORGE Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450
      },
      {
        "label": "splash",
        "create": false,
        "url": "splash.html",
        "title": "STAR FORGE Launcher",
        "width": 420,
        "height": 240,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "starforge"
        ]
      }
    }
  }
}
