# Copy to .env and uncomment what you need. .env is gitignored.
# Development builds of star-forge and sc-launch read this file, and the
# scripts in scripts/ source it. Release builds use real environment variables
# only. Use absolute paths ($HOME is fine in scripts but not in the binaries).
# Command-line flags and launcher settings win over these values, and
# these win over auto-detection (Steam libraries, the game's last Proton).

# Star Conflict install folder (holds win64/ and data/).
#STAR_FORGE_GAME_DIR="/home/you/.local/share/Steam/steamapps/common/star conflict"

# Folder with sc-inject.exe and sc_agent.dll (default: next to the launcher).
#STAR_FORGE_TOOLS_DIR=/path/to/star-forge/dist/linux

# Proton build to run the game with (Linux).
#STAR_FORGE_PROTON=/usr/share/steam/compatibilitytools.d/proton-cachyos-slr

# Launcher data folder: preferences, profiles, launch log
# (default: ~/.local/share/star-forge, %APPDATA%\star-forge on Windows).
#STAR_FORGE_DATA_DIR=

# Binary scripts/install-desktop-entry.sh registers (default: target/debug/star-forge).
#STAR_FORGE_BIN=target/release/star-forge
